#!/usr/bin/env python3
"""Agent Sessions server agent.

Home Assistant runs this over SSH as a forced command (see install.sh), so it is the only thing HA's key can do.
Protocol: SSH_ORIGINAL_COMMAND is "<verb> [base64(json payload)]"; the reply is one JSON line on stdout.
Verbs: info, list, sessions, new, resume, stop, trust, export, import. Sessions run in GNU screen; Claude Code and
Codex CLI are supported. "import" reads its data (base64 of a gzipped transcript) from stdin, not the command line.
Standard library only, Python 3.9+.

Security: whoever can call this (HA's key) gets to start Claude/Codex, so the agent only accepts the flags in ALLOWED,
plus exact arguments the server owner lists in ~/.config/agent-sessions/allowed-args ("<tool> <args...>" per line,
e.g. "codex --add-dir ~/shared", which allows those arguments only together).
Anything else (a prompt, --settings, --mcp-config, -c overrides) could run commands, and is refused.
Folders (new, resumed and trusted) must be inside the home folder. export/import move a Claude Code transcript
between servers (HA copies it), only to and from ~/.claude/projects, size-capped and checked.
"""
import base64, gzip, json, os, re, shlex, shutil, signal, sqlite3, subprocess, sys, time, zlib
from datetime import datetime, timezone
from pathlib import Path

try:
    import tomllib  # Python 3.11+; older servers skip the extra TOML checks
except ImportError:
    tomllib = None

VERSION = "4"  # the HA integration warns when a server runs an older agent (const.AGENT_VERSION)
HOME = Path.home()
CACHE = HOME / ".cache" / "agent-sessions" / "titles.json"
PREFIX = "agent-"  # screen names this agent creates
TOOLS = ("claude", "codex")
SESSION_ID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
SCREEN_ID = re.compile(r"^\d+\.[\w.-]+$")
CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
EXTRA_ARGS = HOME / ".config" / "agent-sessions" / "allowed-args"
MODEL = re.compile(r"^[A-Za-z0-9][\w.\[\]-]{0,63}$")
# flag -> None (no value) or a pattern its whole value must match (fullmatch). Mirrors the HA catalog (const.FLAGS).
ALLOWED = {
    "claude": {"--dangerously-skip-permissions": None, "--remote-control": None, "--continue": None,
               "--verbose": None, "--fork-session": None, "--model": MODEL,
               "--effort": re.compile(r"(low|medium|high|xhigh|max)")},
    "codex": {"--dangerously-bypass-approvals-and-sandbox": None, "--search": None, "--no-alt-screen": None,
              "-m": MODEL, "-c": re.compile(r"model_reasoning_effort=(none|minimal|low|medium|high|xhigh)")},
}
# "--remote-control [name]" takes an optional value, so it always goes last: nothing after it can become its name.
LAST = "--remote-control"
MAX_TRANSFER = 64 * 1024 * 1024  # largest transcript export/import moves (uncompressed)


class Fail(Exception):
    pass


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).isoformat(timespec="seconds") if ts else None


# ---------- tools ----------

def which(tool):
    # A forced command gets a bare PATH; look where installers usually put these, then ask a login shell.
    found = shutil.which(tool) or shutil.which(tool, path=f"{HOME}/.local/bin:{HOME}/bin:/usr/local/bin")
    if found:
        return found
    try:
        r = subprocess.run(["bash", "-lc", f"command -v {tool}"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = r.stdout.strip().splitlines()
    return out[-1] if r.returncode == 0 and out and out[-1].startswith("/") else None


def version(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        return (r.stdout or r.stderr).strip().splitlines()[0][:80] if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, IndexError):
        return None


# ---------- processes and screens ----------

def screens():
    try:
        out = subprocess.run(["screen", "-ls"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    return re.findall(r"^\t(\d+)\.(\S+)\t", out, re.M)  # [(pid, name)]


def children_map():
    kids = {}
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                with open(f"/proc/{p}/stat") as f:
                    ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            kids.setdefault(ppid, []).append(int(p))
    return kids


def descendants(pid, kids):
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def argv(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def proc_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def proc_uid(pid):
    try:
        return os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None


def proc_start(pid):
    try:
        return os.stat(f"/proc/{pid}").st_mtime
    except OSError:
        return None


# ---------- Claude Code ----------

def claude_live():
    """pid -> session json for every running Claude Code process."""
    out = {}
    for f in (HOME / ".claude" / "sessions").glob("*.json"):
        try:
            d = json.loads(f.read_text())
            os.kill(d["pid"], 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        out[d["pid"]] = d
    return out


def _read_ends(path, size):
    with open(path, "rb") as f:
        head = f.read(65536).decode(errors="replace")
        if size <= 65536:
            return head, head
        f.seek(max(65536, size - 262144))
        return head, f.read().decode(errors="replace")


def claude_meta(path, cache):
    """(title, cwd) of a Claude transcript, or (None, None) for an empty session. Cached by mtime and size."""
    st = path.stat()
    key, sig = str(path), [st.st_mtime, st.st_size]
    if key in cache and cache[key][:2] == sig:
        return cache[key][2], cache[key][3]
    head, tail = _read_ends(path, st.st_size)
    cwd = re.search(r'"cwd":"((?:[^"\\]|\\.)*)"', head)
    titles = (re.findall(r'"customTitle":"((?:[^"\\]|\\.)*)"', tail)
              or re.findall(r'"aiTitle":"((?:[^"\\]|\\.)*)"', tail)
              or [t for t in re.findall(r'"role":"user","content":"((?:[^"\\]|\\.)*)"', head) if not t.startswith("<")])
    title = cwd_s = None
    if cwd and titles:  # no prompt and no title = hooks-only session, never used
        title = json.loads(f'"{titles[-1]}"').replace("\n", " ")[:80]
        cwd_s = json.loads(f'"{cwd.group(1)}"')
    cache[key] = sig + [title, cwd_s]
    return title, cwd_s


def claude_files():
    return sorted((HOME / ".claude" / "projects").glob("*/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)


def claude_recent(cache, limit=200):
    out = []
    files = claude_files()
    for k in [k for k in cache if not os.path.exists(k)]:  # transcripts deleted since they were cached
        del cache[k]
    for p in files[:limit]:
        title, cwd = claude_meta(p, cache)
        if title:
            out.append({"tool": "claude", "session_id": p.stem, "title": title, "cwd": cwd,
                        "updated": p.stat().st_mtime})
    return out


# ---------- Codex CLI ----------

def codex_db():
    dbs = sorted(CODEX_HOME.glob("state_*.sqlite"), key=lambda p: int(re.sub(r"\D", "", p.stem) or 0))
    if not dbs:
        return None
    return sqlite3.connect(f"file:{dbs[-1]}?mode=ro", uri=True, timeout=5)


def codex_rows(where="", params=()):
    db = codex_db()
    if not db:
        return []
    try:
        db.row_factory = sqlite3.Row
        return [dict(r) for r in db.execute(
            "SELECT id, rollout_path, cwd, title, name, updated_at FROM threads WHERE archived = 0 " + where, params)]
    except sqlite3.Error:
        return []  # ponytail: schema is Codex-internal; if it changes, Codex sessions just stop being listed
    finally:
        db.close()


def codex_busy(thread_id):
    dbs = sorted(CODEX_HOME.glob("thread_history_*.sqlite"))
    if not dbs:
        return None
    try:
        db = sqlite3.connect(f"file:{dbs[-1]}?mode=ro", uri=True, timeout=5)
        row = db.execute("SELECT status FROM thread_turns WHERE thread_id = ? ORDER BY rollout_ordinal DESC LIMIT 1",
                         (thread_id,)).fetchone()
        db.close()
    except sqlite3.Error:
        return None
    return row and row[0] not in ("completed", "failed", "interrupted", "cancelled")


def codex_title(r):
    return (r.get("name") or r.get("title") or "Codex session").replace("\n", " ")[:80]


def codex_recent():
    return [{"tool": "codex", "session_id": r["id"], "title": codex_title(r), "cwd": r["cwd"],
             "updated": r["updated_at"]}
            for r in codex_rows("AND thread_source IS NOT 'subagent' ORDER BY updated_at DESC LIMIT 100")]


def codex_thread_of(pids):
    """The Codex thread a process tree is writing to, found through its open rollout file."""
    for p in pids:
        try:
            fds = os.listdir(f"/proc/{p}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(f"/proc/{p}/fd/{fd}")
            except OSError:
                continue
            if target.endswith(".jsonl") and "rollout-" in target:
                rows = codex_rows("AND rollout_path = ?", (target,))
                if rows:
                    return rows[0]
    return None


# ---------- verbs ----------

def running(cache=None):
    cache = cache if cache is not None else {}
    kids, live = children_map(), claude_live()
    titles = {}
    out = []
    for spid, name in screens():
        tree = descendants(int(spid), kids)
        item = {"id": f"{spid}.{name}", "name": name, "tool": None, "title": "", "status": "starting",
                "cwd": "", "started": iso(proc_start(int(spid))), "session_id": None}
        claude = next((live[p] for p in tree if p in live), None)
        codex = None if claude else next((p for p in tree if os.path.basename((argv(p) or [""])[0]) == "codex"), None)
        if claude:
            sid = claude.get("sessionId")
            if not titles:
                titles.update({s["session_id"]: s["title"] for s in claude_recent(cache)})
            item.update(tool="claude", session_id=sid, cwd=claude.get("cwd", ""), pid=claude.get("pid"),
                        title=titles.get(sid) or claude.get("name") or "New Claude session",
                        status={"busy": "working", "idle": "idle"}.get(claude.get("status"), "idle"))
            if claude.get("startedAt"):
                item["started"] = iso(claude["startedAt"] / 1000)
        elif codex:
            row = codex_thread_of(descendants(codex, kids))
            item.update(tool="codex", cwd=proc_cwd(codex), title="New Codex session", status="idle", pid=codex)
            if row:
                item.update(session_id=row["id"], title=codex_title(row), cwd=row["cwd"],
                            status="working" if codex_busy(row["id"]) else "idle")
        elif not name.startswith(PREFIX):
            continue  # someone's unrelated screen
        out.append(item)
    return out


def load_cache():
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}


def save_cache(cache, before):
    if cache != before:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(cache))
        os.replace(tmp, CACHE)


def live_ids(run):
    """Session ids open anywhere: in our screens, or in a Claude started elsewhere (terminal, desktop app)."""
    return {r["session_id"] for r in run if r["session_id"]} | {d.get("sessionId") for d in claude_live().values()}


def do_list(p):
    n = int(p.get("recent", 10))
    cache = load_cache()
    before = json.loads(json.dumps(cache))
    run = running(cache)
    busy = live_ids(run)
    recent = sorted([s for s in claude_recent(cache) + codex_recent() if s["session_id"] not in busy],
                    key=lambda s: s["updated"], reverse=True)[:max(0, min(n, 100))]
    for s in recent:
        s["updated"] = iso(s["updated"])
    save_cache(cache, before)
    for r in run:
        r.pop("pid", None)
    return {"agent": VERSION, "home": str(HOME), "running": run, "recent": recent,
            "allowed": {t: [list(a) for a in sorted(extra_args(t))] for t in TOOLS}}


def do_sessions(p):
    """Every resumable session (for the resume picker), newest first; "open" ones are running somewhere now."""
    n = p.get("limit", 100)
    if not isinstance(n, int) or isinstance(n, bool):
        raise Fail("limit must be a number")
    n = max(1, min(n, 300))
    cache = load_cache()
    before = json.loads(json.dumps(cache))
    busy = live_ids(running(cache))
    out = sorted(claude_recent(cache, n) + codex_recent(), key=lambda s: s["updated"], reverse=True)[:n]
    for s in out:
        s["updated"] = iso(s["updated"])
        s["open"] = s["session_id"] in busy
    save_cache(cache, before)
    return {"agent": VERSION, "home": str(HOME), "sessions": out}


def do_info(_):
    tools = {}
    for t in TOOLS:
        path = which(t)
        tools[t] = {"path": path, "version": version([path, "--version"]) if path else None}
    return {"agent": VERSION, "user": HOME.name, "home": str(HOME), "tools": tools,
            "screen": version(["screen", "-v"])}


def _atomic_write(path, text):
    """Replace path with text, keeping its permissions (~/.claude.json is usually 0600); new files get 0600.
    A symlinked file (dotfile managers) is written where the link points, so the link stays."""
    path = Path(os.path.realpath(path))
    tmp = path.with_name(path.name + ".agent-sessions.tmp")
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    tmp.unlink(missing_ok=True)
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def trust_dir(tool, folder):
    if tool == "claude":
        p = HOME / ".claude.json"
        d = json.loads(p.read_text()) if p.exists() else {}
        proj = d.setdefault("projects", {}).setdefault(folder, {})
        if not proj.get("hasTrustDialogAccepted"):  # only write when needed: running Claudes rewrite this file too
            proj["hasTrustDialogAccepted"] = True
            _atomic_write(p, json.dumps(d, indent=2))
    else:
        p = CODEX_HOME / "config.toml"
        text = p.read_text() if p.exists() else ""
        if tomllib:
            try:
                if folder in tomllib.loads(text).get("projects", {}):
                    return  # already listed (in whatever form the user wrote it)
            except tomllib.TOMLDecodeError:
                raise Fail(f"{p} is not valid TOML; not touching it") from None
        header = f"[projects.{json.dumps(folder, ensure_ascii=False)}]"
        if header in text:
            return
        new = text.rstrip("\n") + ("\n\n" if text else "") + f'{header}\ntrust_level = "trusted"\n'
        if tomllib:
            tomllib.loads(new)  # never write a config Codex can't read
        p.parent.mkdir(parents=True, exist_ok=True)
        _atomic_write(p, new)


def folder(path):
    # no control characters or lone surrogates: the path ends up in TOML and JSON config files
    if (not isinstance(path, str) or not path or any(ord(c) < 32 or ord(c) == 127 for c in path)
            or any(0xD800 <= ord(c) <= 0xDFFF for c in path)):
        raise Fail("invalid folder")
    full = os.path.realpath(os.path.expanduser(path))
    home = os.path.realpath(HOME)
    if full != home and not full.startswith(home + os.sep):
        raise Fail(f"folder must be inside {home}: {path}")
    if not os.path.isdir(full):
        raise Fail(f"folder not found: {path}")
    return full


def do_trust(p):
    folders = p.get("folders")
    if not isinstance(folders, list):
        raise Fail("folders must be a list")
    done = []
    for f in folders:
        full = folder(f)
        for t in TOOLS:
            if which(t):
                trust_dir(t, full)
        done.append(full)
    return {"ok": True, "trusted": done}


def extra_args(tool):
    """The argument sequences the server owner allows for tool: one tuple per "<tool> <args...>" line."""
    try:
        lines = EXTRA_ARGS.read_text().splitlines()
    except OSError:
        return set()
    out = set()
    for ln in lines:
        try:
            words = shlex.split(ln)
        except ValueError:
            continue  # unbalanced quotes
        if len(words) > 1 and words[0] == tool:
            out.add(tuple(words[1:]))
    return out


def clean_args(tool, args):
    """args, if every one is allowed for tool (see ALLOWED and EXTRA_ARGS); raises Fail otherwise."""
    if not isinstance(args, list) or len(args) > 40 or not all(isinstance(a, str) for a in args):
        raise Fail("args must be a list of strings")
    allowed, extra, out, i = ALLOWED[tool], extra_args(tool), [], 0
    while i < len(args):
        a = args[i]
        # an allowed-args line matches only as a whole sequence, so "--add-dir ~/shared" never allows another dir
        seq = max((s for s in extra if tuple(args[i:i + len(s)]) == s), key=len, default=None)
        if seq:
            out += [os.path.expanduser(w) for w in seq]  # the session's command is quoted, so bash won't expand ~
            i += len(seq)
        elif a in allowed:
            out.append(a)
            if allowed[a]:
                v = args[i + 1] if i + 1 < len(args) else None
                if v is None or not allowed[a].fullmatch(v):
                    raise Fail(f"invalid value for {a}")
                out.append(v)
                i += 1
            i += 1
        else:
            raise Fail(f"argument not allowed: {a[:60]} (the server owner can allow it in {EXTRA_ARGS})")
    return out


def rc_last(argv):
    """argv with --remote-control moved to the end (its optional value can't swallow what follows)."""
    return [a for a in argv if a != LAST] + ([LAST] if LAST in argv else [])


def tool_of(p):
    t = p.get("tool", "claude")
    if t not in TOOLS:
        raise Fail("unknown tool")
    path = which(t)
    if not path:
        raise Fail(f"{t} is not installed on this server")
    return t, path


def launch(tool, path, cwd, args, label, trust):
    if trust:
        trust_dir(tool, cwd)
    slug = re.sub(r"[^\w-]+", "-", label or datetime.now().strftime("%m%d-%H%M%S")).strip("-")[:40] or "session"
    taken = {n for _, n in screens()}
    name = f"{PREFIX}{tool}-{slug}"
    i = 2
    while name in taken:
        name, i = f"{PREFIX}{tool}-{slug}-{i}", i + 1
    # bash -li gives the session the user's normal environment (PATH, nvm, pyenv). The screen ends when the tool exits.
    # Drop HA's request from the session's environment, or running the agent inside a session would replay it. Also
    # drop a parent Claude Code's session markers (CLAUDECODE, CLAUDE_CODE_*): the new session would think it is a child
    # session and stop saving its transcript, and it would inherit the parent's messaging token.
    env = {k: v for k, v in os.environ.items() if k not in ("SSH_ORIGINAL_COMMAND", "CLAUDECODE", "CLAUDE_PID",
                                                            "CLAUDE_EFFORT") and not k.startswith("CLAUDE_CODE_")}
    subprocess.run(["screen", "-dmS", name, "bash", "-lic", shlex.join([path, *rc_last(args)])], cwd=cwd, check=True,
                   timeout=15, env=env)
    for _ in range(20):
        sid = next((f"{s}.{n}" for s, n in screens() if n == name), None)
        if sid:
            return {"ok": True, "id": sid}
        time.sleep(0.1)
    raise Fail("screen did not start")


def do_new(p):
    tool, path = tool_of(p)
    cwd = folder(p.get("cwd") or "~")
    args = clean_args(tool, p.get("args", []))
    name = p.get("name") or ""
    if not isinstance(name, str) or len(name) > 80:
        raise Fail("invalid name")
    if name and tool == "claude" and "--name" not in args and "-n" not in args:
        args += ["--name", name]
    return launch(tool, path, cwd, args, name, bool(p.get("trust")))


def resuming(sid):
    """A resume of sid that is still starting: this user's screen/bash/tool processes resuming it.
    Needed because a just-resumed Claude has not written its session file yet."""
    me = os.getuid()
    for q in os.listdir("/proc"):
        if q.isdigit() and int(q) != os.getpid():
            if proc_uid(q) != me:
                continue  # other users can't block our resumes
            a = argv(int(q))
            if a and os.path.basename(a[0]) in ("screen", "SCREEN", "bash", "claude", "codex", "node"):
                words = [w for x in a for w in x.split()]  # bash -lic '<one string>' holds the whole command
                if sid in words and ("--resume" in words or "resume" in words):
                    return True
    return False


def session_id(p):
    sid = p.get("session_id")
    if not isinstance(sid, str) or not SESSION_ID.fullmatch(sid):
        raise Fail("invalid session id")
    return sid


def do_resume(p):
    tool, path = tool_of(p)
    sid = session_id(p)
    if sid in live_ids(running()) or resuming(sid):
        raise Fail("that session is already running")
    args = clean_args(tool, p.get("args", []))
    if tool == "claude":
        found = next((s for s in claude_recent(load_cache()) if s["session_id"] == sid), None)
        argv_ = [*args, "--resume", sid]
    else:
        found = next(({"cwd": r["cwd"], "title": codex_title(r)} for r in codex_rows("AND id = ?", (sid,))), None)
        argv_ = ["resume", *args, sid]
    if found is None:
        raise Fail("session not found")
    trust = bool(p.get("trust"))
    if p.get("cwd"):
        cwd = folder(p["cwd"])  # picked in the card (a session copied from another server)
    elif os.path.isdir(found["cwd"] or ""):
        cwd = folder(found["cwd"])  # inside home, like new sessions
    else:
        cwd, trust = str(HOME), False  # its folder is gone: run in home, but never mark all of home trusted
    name = p.get("name") or found["title"]
    if not isinstance(name, str) or len(name) > 80:
        raise Fail("invalid name")
    return launch(tool, path, cwd, argv_, name, trust)


def do_stop(p):
    sid = p.get("id")
    if not isinstance(sid, str) or not SCREEN_ID.fullmatch(sid):
        raise Fail("invalid session")
    item = next((r for r in running() if r["id"] == sid), None)  # only what the card lists, never other screens
    if item is None:
        raise Fail("no such session")
    if item["name"].startswith(PREFIX):
        subprocess.run(["screen", "-S", sid, "-X", "quit"], timeout=10)
    elif item.get("pid"):
        os.kill(int(item["pid"]), signal.SIGTERM)  # the user's own screen: stop the tool, keep their other windows
    else:
        raise Fail("no such session")
    return {"ok": True}


# ---------- moving a Claude Code session between servers (HA reads it from one and writes it to the other) ----------

def project_dir(cwd):
    """~/.claude/projects/<cwd with every non-alphanumeric character as "-">, where Claude Code keeps transcripts."""
    slug = re.sub(r"[^A-Za-z0-9]", "-", cwd)
    if len(slug) > 200:
        raise Fail("folder path is too long to copy a session into")
    return HOME / ".claude" / "projects" / slug


def transcript(sid):
    return next((p for p in (HOME / ".claude" / "projects").glob(f"*/{sid}.jsonl") if p.is_file()), None)


def do_export(p):
    if p.get("tool", "claude") != "claude":
        raise Fail("only Claude Code sessions can move between servers")
    sid = session_id(p)
    if sid in live_ids(running()):
        raise Fail("that session is running; stop it first, or resume it with --fork-session")
    src = transcript(sid)
    if src is None:
        raise Fail("session not found")
    if src.stat().st_size > MAX_TRANSFER:
        raise Fail(f"session is larger than {MAX_TRANSFER // 1048576} MB")
    title, cwd = claude_meta(src, {})
    data = base64.b64encode(gzip.compress(src.read_bytes(), 6)).decode()
    return {"session_id": sid, "title": title, "cwd": cwd, "home": str(HOME), "data": data}


def _gunzip(raw):
    d = zlib.decompressobj(wbits=31)
    out = d.decompress(raw, MAX_TRANSFER + 1)
    if len(out) > MAX_TRANSFER or d.unconsumed_tail:
        raise Fail(f"session is larger than {MAX_TRANSFER // 1048576} MB")
    return out


def do_import(p, stdin=""):
    if p.get("tool", "claude") != "claude":
        raise Fail("only Claude Code sessions can move between servers")
    sid = session_id(p)
    cwd = folder(p.get("cwd") or "~")
    if transcript(sid):
        raise Fail("that session is already on this server")
    try:
        body = _gunzip(base64.b64decode(stdin.strip(), validate=True))
        lines = [json.loads(ln) for ln in body.decode("utf-8").splitlines() if ln.strip()]
    except (ValueError, zlib.error, EOFError, RecursionError):
        raise Fail("the session data is damaged") from None
    if not all(isinstance(x, dict) for x in lines) or not any(x.get("sessionId") == sid for x in lines):
        raise Fail("that is not a transcript of this session")
    dest = project_dir(cwd)
    dest.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = dest / f"{sid}.jsonl"
    tmp = dest / f".{sid}.agent-sessions.tmp"
    tmp.unlink(missing_ok=True)
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as f:
        f.write(body)
    os.link(tmp, target)  # fails if it appeared meanwhile; never overwrites a transcript
    tmp.unlink()
    return {"ok": True, "cwd": cwd}


VERBS = {"info": do_info, "list": do_list, "sessions": do_sessions, "new": do_new, "resume": do_resume,
         "stop": do_stop, "trust": do_trust, "export": do_export, "import": do_import}


def main(command, stdin=None):
    verb, _, raw = command.strip().partition(" ")
    if verb not in VERBS:
        return {"error": f"unknown command {verb!r}"}
    try:
        payload = json.loads(base64.b64decode(raw, validate=True)) if raw else {}
        if not isinstance(payload, dict):
            raise Fail("payload must be an object")
        if verb == "import":
            # base64 of at most MAX_TRANSFER gzipped (gzip can grow incompressible data a little)
            data = (sys.stdin.read(MAX_TRANSFER * 4 // 3 + 65536) if stdin is None else stdin)
            return do_import(payload, data)
        return VERBS[verb](payload)
    except Fail as e:
        return {"error": str(e)}
    except (ValueError, TypeError, RecursionError) as e:
        return {"error": f"bad request: {str(e)[:200] or type(e).__name__}"}
    except subprocess.SubprocessError as e:
        return {"error": f"command failed: {e}"}


if __name__ == "__main__":
    print(json.dumps(main(" ".join(sys.argv[1:]) or os.environ.get("SSH_ORIGINAL_COMMAND", ""))))
